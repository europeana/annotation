apiVersion: apps/v1
kind: Deployment
metadata:
  name: annotation-api-deployment
spec:
  replicas: ${MIN_REPLICAS}
  template:
    metadata:
      annotations:
        fluentd/include: '${COLLECT_LOGS}'
        fluentd/multiline: 'true'
    spec:
      containers:
        - name: annotation-api
#          image: europeana/annotation-api:${DOCKER_IMAGE_TAG}
          imagePullPolicy: Always
          env:
            - name: JAVA_TOOL_OPTIONS
              value: "-javaagent:\"/opt/app/elastic-apm-agent.jar\"
                     -Delastic.apm.enabled=${COLLECT_APM}
                     -Delastic.apm.application_packages=${ELASTIC_APP_PACKAGES}
                     -Delastic.apm.server_urls=${ELASTIC_APM_SERVERS}
                     -Delastic.apm.service_name=${APP_NAME}
                     -Delastic.apm.environment=${K8S_NAMESPACE}
                     -Dlogging.config=/opt/app/config/log4j2-spring.xml"
          livenessProbe:
            httpGet:
              port: 8080
              path: /actuator/health/liveness
              httpHeaders:
              - name: Accept
                value: application/json
            initialDelaySeconds: ${LIVE_CHECK_INIT_DELAY}
            periodSeconds: ${LIVE_CHECK_PERIOD}
            failureThreshold: ${FAIL_CHECK_THRESHOLD}
          readinessProbe:
            httpGet:
              port: 8080
              path: /actuator/health/readiness
              httpHeaders:
              - name: Accept
                value: application/json
            initialDelaySeconds: ${READY_CHECK_INIT_DELAY}
            periodSeconds: ${READY_CHECK_PERIOD}
            failureThreshold: ${FAIL_CHECK_THRESHOLD}
          resources:
            requests:
              memory: "${MEMORY_REQUEST}M"
              cpu: "${CPU_REQUEST}m"
            limits:
              memory: "${MEMORY_LIMIT}M"
              cpu: "${CPU_LIMIT}m"           
          volumeMounts:
            - name: ibm-certificate
              mountPath: "/opt/app/config/ibm-databases-truststore.jks"
              readOnly: true
              subPath: ibm-databases-truststore.jks
      volumes:
        - name: ibm-certificate
          secret:
            secretName: ibm-secret   
